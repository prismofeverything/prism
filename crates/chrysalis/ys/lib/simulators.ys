# ─────────────────────────────────────────────────────────────────────────
# simulators — a reusable library of contracted simulation processes.
# ─────────────────────────────────────────────────────────────────────────
#
# The process LIBRARY indexed by contract. A workflow imports this, declares the
# CONTRACT each step needs, and `fulfillers(C)` returns every method here whose
# contract refines it. Native and (later) external simulators all live here as
# contracted processes — indistinguishable to the query and the fan-out. See
# docs/agreement-demo.md and docs/process-contracts.md.

type TimeSeries = {
  times: list[float],
  columns: map[list[float]]
}

type Ensemble = {
  times: list[float],
  mean: map[list[float]],
  std: map[list[float]]
}

# ── The two points in contract-space ────────────────────────────────────
contract DeterministicMassAction (
  target:  MassActionODE,
  claims:  Deterministic,
  advance: Continuous
)

contract ExactCME (
  target:  ChemicalMasterEquation,
  claims:  Distributional,
  advance: DiscreteEvent
)

from integrators import rk4, euler
from stochastic import ssa
from chem import CRN

# ── Deterministic fulfillers — the mass-action ODE, two methods ──────────
process Rk4[network: CRN]
  fulfills DeterministicMassAction[method: Rk4]
  ~{state: map[float]} ->{state: map[float]}
  ( rk4.integrate(network, state, interval) )

process ForwardEuler[network: CRN]
  fulfills DeterministicMassAction[method: ForwardEuler]
  ~{state: map[float]} ->{state: map[float]}
  ( euler.integrate(network, state, interval) )

# ── Stochastic fulfillers — the exact CME, single paths and ensembles ────
step Ssa[network: CRN, runtime: float, timestep: float, seed: float]
  fulfills ExactCME[method: SsaDirect]
  ~{state: map[float]} ->{timeseries: TimeSeries}
  ( {timeseries: ssa.simulate(network, state, runtime, timestep, seed)} )

step SsaEnsemble[network: CRN, runtime: float, timestep: float, base_seed: float, n_runs: float]
  fulfills ExactCME[method: SsaDirect]
  ~{state: map[float]} ->{ensemble: Ensemble}
  ( {ensemble: ssa.ensemble(network, state, runtime, timestep, base_seed, n_runs)} )

# ── Claim-driven comparisons — each DEMANDS its contract (the teeth) ──────
# The CLAIM selects the metric: trajectory MSE for a Deterministic claim, a
# distributional distance for a Distributional one. The `:: C` demands make
# wiring a trajectory into the wrong comparison a compile error.
step Compare ~{
  a: TimeSeries :: DeterministicMassAction,
  b: TimeSeries :: DeterministicMassAction
} ->{mse: map[float]} (
  {mse: a.species_mse(b)}
)

step DistCompare ~{
  a: Ensemble :: ExactCME,
  b: Ensemble :: ExactCME
} ->{distance: map[float]} (
  {distance: a.distributional_distance(b)}
)
