# ─────────────────────────────────────────────────────────────────────────
# The CME lane — Gillespie SSA fulfilling ExactCME, compared DISTRIBUTIONALLY.
# ─────────────────────────────────────────────────────────────────────────
#
# A single SSA trajectory is one *sample* of the chemical master equation —
# jagged, and different every seed — so two fulfillers of ExactCME agree only
# DISTRIBUTIONALLY, never pathwise. `DistCompare` DEMANDS the ExactCME contract,
# so a deterministic trajectory is refused there (the wrong metric won't compile).
#
# The contracts, the SSA fulfillers, and the comparison all come from the shared
# process library (lib/simulators.ys) — this file imports it, picks the model,
# and composes a workflow.

import Simulators from 'lib/simulators.ys'

# The shared model — A -> B at k = 0.7.
def network :: CRN = {species: ['A', 'B'], reactions: [{reactants: {A: 1.0}, products: {B: 1.0}, k: 0.7}]}

# Two independent ensembles (disjoint seed ranges) of the SAME process: their
# distributions agree (small distance) even though individual paths do not.
composite Cme ->{distance: map[float]} (
  init: {A: 100.0, B: 0.0} |
  ea: SsaEnsemble[
    network: network,
    runtime: 5.0,
    timestep: 0.2,
    base_seed: 1.0,
    n_runs: 64.0
  ] ~{state: init} ->{ensemble: ens_a} |
  eb: SsaEnsemble[
    network: network,
    runtime: 5.0,
    timestep: 0.2,
    base_seed: 1000.0,
    n_runs: 64.0
  ] ~{state: init} ->{ensemble: ens_b} |
  cmp: DistCompare ~{a: ens_a, b: ens_b} ->{distance: distance}
)

Cme[]
