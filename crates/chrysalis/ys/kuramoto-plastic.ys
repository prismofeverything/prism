# kuramoto-plastic.ys — Demo 3: the network learns its own wiring.
# ──────────────────────────────────────────────────────────────────────────
# Each oscillator carries a PLASTIC coupling weight `w`, updated by a Hebbian
# rule  dw = eta * (align - w)  where  align = R*cos(Ψ-θ)  is how in-phase it is
# with the mean field. In-phase oscillators STRENGTHEN (w -> R); drifting ones
# DECOUPLE (w -> 0). So the synchronized core self-reinforces and stragglers are
# shed — the DYNAMICS reshape the WIRING (the soft topology: w->0 = a pruned
# coupling). The M/R closure made dynamical (categorical-core §9 Demo 3): the
# system rewrites its own structure from its own state.
#
# Two shared links (both per-source, single-writer-per-key): `field` is the mean-
# field pool (Demo 1); `weights` SURFACES each oscillator's learned weight to its
# own key, so the parent (and a test) can see the learned topology — child inner
# state is otherwise encapsulated.

process PlasticSpin[id :: string = '0', omega :: Float = 1.0, k :: Float = 3.0, n :: Float = 8.0, dt :: Float = 0.05, eta :: Float = 0.4]
  ~{theta :: Float, weight :: Float, field :: array[[2], float], weights :: map[float], interval :: Float = 1.0}
  ->{theta :: Float, weight :: Float, field :: array[[2], float], weights :: map[float]}
(
  sx       = field.at(0) |
  sy       = field.at(1) |
  c        = theta.cos() |
  s        = theta.sin() |
  align    = (sx * c + sy * s) / n |                  # R*cos(Ψ-θ): this oscillator's coherence with the field
  coupling = weight * (k / n) * (sy * c - sx * s) |   # coupling SCALED by the plastic weight
  dtheta   = (omega + coupling) * dt |
  dweight  = eta * (align - weight) * dt |            # Hebbian: weight tracks alignment
  next     = theta + dtheta |
  {theta: dtheta, weight: dweight, field: [next.cos() - c, next.sin() - s], weights: {'{id}': dweight}}
)

composite PlasticOscillator[id :: string = '0', theta0 :: Float = 0.0, omega :: Float = 1.0, k :: Float = 3.0, n :: Float = 8.0]
  ~{field :: array[[2], float] @ field = [0.0, 0.0], weights :: map[float] @ weights = {}}
  ->{weight :: Float @ weight, field :: array[[2], float] @ field, weights :: map[float] @ weights}
(
  theta: theta0 |
  weight: 1.0 |
  field: field |
  weights: weights |
  spin: PlasticSpin[id: id, omega: omega, k: k, n: n] ~{theta: theta, weight: weight, field: field, weights: weights} ->{theta: theta, weight: weight, field: field, weights: weights}
)

# A spread of frequencies: a CORE near the mean (0.9..1.1) that entrains, and
# OUTLIERS far from it (0.2, 0.5, 1.5, 1.8) that drift — so plasticity has a real
# structure to learn (strengthen the core, shed the outliers).
composite PlasticTile[
  omegas :: map[Float] = {
    '0': 0.2, '1': 0.5, '2': 0.9, '3': 1.0,
    '4': 1.0, '5': 1.1, '6': 1.5, '7': 1.8
  },
  k :: Float = 3.0,
  n :: Float = 8.0
]
  ->{field :: array[[2], float] @ field, weights :: map[float] @ weights}
(
  link field :: array[[2], float] = [8.0, 0.0] |
  link weights :: map[float] = { '{id}': 1.0 for id, w in omegas } |
  oscillators: {
    '{id}': PlasticOscillator[id: id, theta0: 0.0, omega: w, k: k, n: n] ~{field: ~field, weights: ~weights} ->{field: ~field, weights: ~weights}
    for id, w in omegas
  }
)
