# Process-contract tier-1 demo (docs/process-contracts.md), as a one-shot Step
# network. Two RUST-NATIVE *stepwise* integrator Processes (Rk4, ForwardEuler)
# are each wrapped by a `RunProcess` Step that runs them over [0, runtime] and
# emits a `TimeSeries`. A ys-native `Compare` step MSEs the two trajectories.
#
# Integrators are plain Processes (one step per update — reusable); `RunProcess`
# turns one into a one-shot Step. The whole workflow is a one-shot Step DAG, fired
# in dependency order by the engine. `TimeSeries`/`Figure` are declared ys types
# (Values, not Foreign): their methods (species_mse, overlay) dispatch on `_type`.
#
# (Contracts: Rk4/ForwardEuler `fulfill` DeterministicMassAction, but the demand
# on Compare's inputs returns in #9, when the contract propagates through
# RunProcess to the timeseries output.)

type TimeSeries = {times: list[float], columns: map[list[float]]}
type Figure = {svg: string}

contract DeterministicMassAction (target: MassActionODE, claims: Deterministic, advance: Continuous)

extern Rk4[network: any]
  ~{state: map[float]} ->{state: map[float]}
  fulfills DeterministicMassAction[method: Rk4]

extern ForwardEuler[network: any]
  ~{state: map[float]} ->{state: map[float]}
  fulfills DeterministicMassAction[method: ForwardEuler]

extern RunProcess[proc: any, runtime: float, timestep: float]
  ~{state: map[float]} ->{timeseries: TimeSeries}

step Compare ~{a: TimeSeries, b: TimeSeries} ->{mse: map[float]} (
  { mse: a.species_mse(b) }
)

composite IntegratorComparison ->{mse: map[float]} (
  init: {A: 1.0, B: 0.0} |
  rk4: RunProcess[proc: Rk4[network: {species: ['A', 'B'], reactions: [{reactants: {A: 1.0}, products: {B: 1.0}, k: 0.7}]}], runtime: 5.0, timestep: 0.2]
         ~{state: init} ->{timeseries: rk4_traj} |
  euler: RunProcess[proc: ForwardEuler[network: {species: ['A', 'B'], reactions: [{reactants: {A: 1.0}, products: {B: 1.0}, k: 0.7}]}], runtime: 5.0, timestep: 0.2]
         ~{state: init} ->{timeseries: euler_traj} |
  compare: Compare ~{a: rk4_traj, b: euler_traj} ->{mse: mse}
)

IntegratorComparison[]
