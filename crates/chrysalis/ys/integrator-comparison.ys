# ─────────────────────────────────────────────────────────────────────────
# Process contracts — a worked demonstration (docs/process-contracts.md)
# ─────────────────────────────────────────────────────────────────────────
#
# THE PROBLEM. To compare two simulators you wire them to the same inputs and
# diff their outputs. But matching port *shapes* ("counts in, a time series
# out") does NOT make two processes comparable: an exact-stochastic trajectory,
# a deterministic ODE, and a well-mixed PDE collapse can all share that shape
# while approximating *different mathematical objects*. Diffing them is a
# category error the interface can't see. (This is the gap underneath SED-ML /
# KISAO "reproducibility" — see the doc.)
#
# A PROCESS CONTRACT is the missing layer: it states a process's *meaning*, not
# just its shape — which mathematical object it approximates (target), how it
# realizes it (method), and the sense in which two realizations may agree
# (claims / advance). A contract is to a port interface what a schema is to a
# value: inseparable from it, and checked at wiring time.
#
# HOW IT WORKS HERE. `DeterministicMassAction` is one point in contract-space:
# target = the deterministic mass-action ODE, claims = Deterministic; `method`
# is left open. `Rk4` and `ForwardEuler` each `fulfill` it — same target,
# *different* method — so they are substitutable, and comparing their
# trajectories is warranted *by construction*. A process targeting a different
# object (Gillespie → the CME; FBA → a steady-state flux polytope) fulfills a
# DIFFERENT contract, so wiring it into this comparison would not compile. The
# MSE this workflow reports therefore has a warrant: it measures method-space
# distance at a shared target, not an accidental diff of incomparable things.
#
# THE WORKFLOW. A shared `network` (the reaction model) feeds two `RunProcess`
# steps that drive the integrators over [0, runtime], each emitting a
# `TimeSeries`; `Compare` MSEs them, `Plot` overlays them, `Output` writes the
# artifacts. The whole thing is a one-shot Step DAG the engine fires in
# dependency order. Integrators (`rk4`/`euler`), the model type (`CRN`), and
# `RunProcess` are imported native capabilities; the ports, the contract, and
# the comparison are the language's.

from chrysalis.lib.simulators import Rk4, ForwardEuler, Compare

# The library (lib/simulators.ys) supplies the DeterministicMassAction contract,
# the Rk4 / ForwardEuler fulfillers, and the warranted `Compare`. This file adds
# the figure, the model, and the workflow.
type Figure = {svg: string}

from core import RunProcess
from io import Path

# `Rk4` / `ForwardEuler` (the fulfillers) and the warranted `Compare` come from
# lib/simulators.ys. `Plot` overlays the two trajectories; `Output` writes the
# artifacts itself (`.csv`/`.svg` are native effects).

step Plot ~{a: TimeSeries, b: TimeSeries} ->{figure: Figure} (
  {figure: a.overlay(b, 'Rk4 vs ForwardEuler')}
)

step Output[path: Path] ~{a: TimeSeries, b: TimeSeries, mse: map[float], figure: Figure} (
  a.csv(path / a.name) |
  b.csv(path / b.name) |
  mse.csv(path / 'mse') |
  figure.svg(path / 'overlay')
)

# The shared model — defined once, referenced by both integrators, and realized
# into a reaction network by the integrator method.
def network :: CRN = {species: ['A', 'B'], reactions: [{reactants: {A: 1.0}, products: {B: 1.0}, k: 0.7}]}

# The workflow: shared model → two integrators → compare / plot / output.
composite IntegratorComparison[out: Path = 'outputs/integrator-comparison'] ->{mse: map[float], figure: Figure} (
  init: {A: 1.0, B: 0.0} |
  rk4: RunProcess[proc: Rk4[network: network], runtime: 5.0, timestep: 0.2] ~{state: init} ->{timeseries: rk4_traj} |
  euler: RunProcess[proc: ForwardEuler[network: network], runtime: 5.0, timestep: 0.2] ~{state: init} ->{timeseries: euler_traj} |
  compare: Compare ~{a: rk4_traj, b: euler_traj} ->{mse: mse} |
  plot: Plot ~{a: rk4_traj, b: euler_traj} ->{figure: figure} |
  output: Output[path: out] ~{a: rk4_traj, b: euler_traj, mse: mse, figure: figure}
)

IntegratorComparison[]
