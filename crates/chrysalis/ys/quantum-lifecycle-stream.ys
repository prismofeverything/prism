# Streaming variant of quantum-lifecycle.ys — each QuantumSystem runs as
# its OWN `chrysalis run quantum-system.ys --serve-process` child over
# Arrow pipes (the `stream:` protocol), not a local in-thread composite.
# ────────────────────────────────────────────────────────────────────
#
# The ONLY change from quantum-lifecycle.ys is `QuantumSystem` →
# `StreamingQuantumSystem` (a `stream<…>` alias) + the slot type. The
# structural `_remove`/`_add` ride the (already update-based) output
# bridge, so split/merge crosses the wire unchanged (proven by
# grow_divide_stream.rs). Uses the `Qubits` type's methods — `.factorize`
# / `.tensor` — exactly as the local version does.
#
#       t=0 { ab: |++⟩ }  →  t=1 { a: |+⟩, b: |+⟩ }  →  t=2+ { ab2: |++⟩ }

from quantum-system import QuantumSystem

protocol StreamingQuantumSystem = stream<QuantumSystem, path: 'quantum-system.ys'>

process Lifecycle
  ~{systems :: map[StreamingQuantumSystem]}
  ->{systems :: map[StreamingQuantumSystem]}
(
  if 'ab' in systems then
    {systems: {
      _remove: ['ab'],
      _add: {
        a: StreamingQuantumSystem[state0: systems.ab.state.factorize(1.0).a]
            ~{state: %.state} ->{state: %.state},
        b: StreamingQuantumSystem[state0: systems.ab.state.factorize(1.0).b]
            ~{state: %.state} ->{state: %.state}
      }
    }}
  else
    if 'a' in systems then
      if 'b' in systems then
        {systems: {
          _remove: ['a', 'b'],
          _add: {
            ab2: StreamingQuantumSystem[state0: systems.a.state.tensor(systems.b.state)]
                  ~{state: %.state} ->{state: %.state}
          }
        }}
      else
        {systems: {}}
    else
      {systems: {}}
)

composite Lab ~{} ->{
  systems :: map[StreamingQuantumSystem] @ systems
} (
  systems: {
    ab: StreamingQuantumSystem[state0: {_type: 'Qubits', '00': 0.5, '01': 0.5, '10': 0.5, '11': 0.5}]
      ~{state: %.state} ->{state: %.state}
  } |
  cycle: Lifecycle ~{systems: systems} ->{systems: systems}
)
