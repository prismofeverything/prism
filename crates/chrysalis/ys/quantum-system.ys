# `QuantumSystem` — a sub-composite holding a single `Qubits` register on
# its bridge. Designed for use as a typed `map[QuantumSystem]` entry (per
# quantum-lifecycle.ys / quantum-auto-split.ys).
#
# `state :: Qubits` — the quantum-register type (bitstring → amplitude),
# whose `apply` is OVERWRITE: a republished snapshot REPLACES at the parent
# slot, never additively accumulates. So the `Publish` process below can
# re-emit `state` every tick (surfacing the snapshot through the bridge to a
# parent step) without the amplitudes doubling — the type carries the
# replace law, no `overwrite[…]` annotation needed.
#
# State keys are bitstrings ('0'/'1' for one qubit; '00'/'01'/'10'/'11' for
# two). The split/merge lifecycle mutates the keyset freely as the qubit
# methods (`factorize`/`tensor`/`cnot`/…) change the structure.

# Output port is `overwrite[Qubits]`: a republished snapshot REPLACES at the
# parent slot. (The `Qubits` type's own apply is already overwrite; the
# explicit wrapper is what survives schema reconciliation across the stream
# bridge, where the node carries no port schema — see task #8: `resolve`
# should preserve a declared `Custom` against an inferred structural type.)
process Publish ~{state :: Qubits} ->{state :: overwrite[Qubits]}
(
  {state: state}
)

composite QuantumSystem[state0 :: Qubits = {_type: 'Qubits', '0': 1.0, '1': 0.0}]
  ~{state :: Qubits @ state = state0}
  ->{state :: overwrite[Qubits] @ state}
(
  state: state0 |
  publish: Publish ~{state: state} ->{state: state}
)
