# Autonomous, PHYSICS-DRIVEN split over the stream protocol — the place
# graph comes to mirror the entanglement structure on its own.
# ────────────────────────────────────────────────────────────────────
#
# The decision is driven by the `Qubits` type's `separable` query on each
# system's LIVE state, not a key name: a system splits *because* its state
# factorizes; an entangled one STAYS JOINT *because* it doesn't.
#
#       t=0                          t=1
#   { sep:  |++⟩ (separable),  →   { sep_0: |+⟩, sep_1: |+⟩,   ← SPLIT
#     bell: Bell (entangled) }       bell:  Bell }              ← stays
#
# `sep` factorizes (rank-1) → replaced by its two factor children; `bell`
# = (|00⟩+|11⟩)/√2 is rank-2 → `.separable(1)` is false → stays one joint
# composite. Each system is its own `--serve-process` stream child.

from quantum-system import QuantumSystem

protocol StreamingQuantumSystem = stream<QuantumSystem, path: 'quantum-system.ys'>

# Apply the SAME rule — "split iff your state factorizes" — to each system.
# The factor states come straight from `.factorize(1)` of the live state, so
# the split is a consequence of the physics, not a script.
process AutoSplit
  ~{systems :: map[StreamingQuantumSystem]}
  ->{systems :: map[StreamingQuantumSystem]}
(
  if 'sep' in systems then
    if systems.sep.state.separable(1.0) then
      {systems: {
        _remove: ['sep'],
        _add: {
          sep_0: StreamingQuantumSystem[state0: systems.sep.state.factorize(1.0).a]
                  ~{state: %.state} ->{state: %.state},
          sep_1: StreamingQuantumSystem[state0: systems.sep.state.factorize(1.0).b]
                  ~{state: %.state} ->{state: %.state}
        }
      }}
    else
      {systems: {}}
  else
    if 'bell' in systems then
      if systems.bell.state.separable(1.0) then
        {systems: {_remove: ['bell']}}
      else
        {systems: {}}
    else
      {systems: {}}
)

composite Lab ~{} ->{
  systems :: map[StreamingQuantumSystem] @ systems
} (
  systems: {
    sep: StreamingQuantumSystem[state0: {_type: 'Qubits', '00': 0.5, '01': 0.5, '10': 0.5, '11': 0.5}]
      ~{state: %.state} ->{state: %.state},
    bell: StreamingQuantumSystem[state0: {_type: 'Qubits', '00': 0.7071067811865476, '01': 0.0, '10': 0.0, '11': 0.7071067811865476}]
      ~{state: %.state} ->{state: %.state}
  } |
  split: AutoSplit ~{systems: systems} ->{systems: systems}
)
