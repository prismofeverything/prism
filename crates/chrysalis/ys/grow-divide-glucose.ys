# Grow / divide on a shared glucose pool — the link-graph surface
# ──────────────────────────────────────────────────────────────────────
# Cells grow on a FINITE shared glucose pool and divide when big enough.
# Two firsts make this run end-to-end:
#
#   1. `link glucose` is the shared pool — a value-bearing HYPEREDGE. Every
#      cell attaches by NAME (`~{glucose: ~glucose}`), so all cells read the
#      SAME level and their uptakes accumulate on the ONE slot. The engine
#      resolves `~glucose` up the place graph to the nearest `link glucose`
#      (depth-independent — a daughter attaches wherever it lands). As the
#      population grows, total uptake grows, the pool depletes, and growth
#      slows to zero: biomass SATURATES rather than diverging.
#
#   2. Division is a first-class BRS REACTION: `?c :: Cell[mass: ?m] where
#      ?m > threshold => ?c.divide()`. The redex binds the matched cell as a
#      typed value `?c`; `?c.divide()` emits a binary `_divide` directive; the
#      engine enacts the schema-driven split (`divide_by_schema(CompositeLink)`:
#      mass halves, the spec — including the pool attachment — is inherited by
#      both daughters). It is the SAME split the Form-3 Divider uses.
#
# Mass is CONSERVED every tick: the pool's glucose becomes biomass (Δmass = u,
# Δglucose = −u), and division splits mass — so glucose + Σ(cell mass) = const.
# The invariant + bounded division are asserted in
# crates/chrysalis/tests/grow_divide_glucose.rs.
#
# Run: `chrysalis run grow-divide-glucose.ys --time 200`


# ── Dimensioned scalar types ────────────────────────────────────────
# Both `Mass` and `Glucose` are EXTENSIVE (→ `Delta`): they split on divide
# and accumulate on apply. (Extensivity is the schema's, orthogonal to unit.)
unit pg   : [mass]      = 1e-12 kg
unit fmol : [substance] = 1e-15 mol
Mass    = Quantity[unit: pg,   extensive]   # cell biomass
Glucose = Quantity[unit: fmol, extensive]   # the shared pool — depletes


# Monod-limited, mass-balanced metabolism: glucose → biomass, bounded by the
# AVAILABLE pool so a shared pool can never be drawn negative (under the BSP
# snapshot every cell reads the same pre-tick glucose).
process Grow[mu_max :: Float = 0.3, k_half :: Float = 50.0]
  ~{mass :: Float, glucose :: Float, interval :: Float = 1.0}
  ->{mass :: Mass, glucose :: Glucose}
(
  mu  = mu_max * glucose / (k_half + glucose) |   # 1/s · (fmol/fmol) = 1/s
  raw = mu * mass * interval |                    # (1/s)·pg·s = pg
  u   = if raw > glucose then glucose else raw |  # never overdraw the pool
  {mass: u, glucose: -u}                          # +biomass here; −glucose on the pool
)


# A cell exposes its `mass` on its OWN node (`%.mass`) so the parent BRS can
# match it, and reads/writes the shared glucose pool BY NAME (`~glucose`).
composite Cell[mass0 :: Mass = 1.0]
  ~{glucose :: Float @ glucose = 0.0}
  ->{mass :: Mass @ mass, glucose :: Glucose @ glucose}
(
  mass: mass0 |
  glucose: glucose |
  grow: Grow[] ~{mass: mass, glucose: glucose} ->{mass: mass, glucose: glucose}
)


# When a cell's biomass crosses the threshold it is replaced by two daughters
# (mass halved by the schema; the pool attachment inherited from the spec).
reaction Divide[threshold :: Mass = 2.0] (
  ?c :: Cell[mass: ?m] where ?m > threshold => ?c.divide()
)


composite Environment[glucose0 :: Float = 1000.0, threshold :: Mass = 2.0]
  ->{glucose :: Float @ glucose, cells :: map[Cell] @ cells}
(
  link glucose :: Glucose = glucose0 |          # the one shared pool (hyperedge)
  cells: {
    '0': Cell[mass0: 1.2] ~{glucose: ~glucose} ->{mass: %.mass, glucose: ~glucose}
  } |
  rxn: BRS[rules: [Divide[threshold: threshold]]] ~{state: cells} ->{state: cells}
)


# The entry — `chrysalis run grow-divide-glucose.ys --time 200` runs the
# environment long enough to deplete the pool and reach the biomass asymptote.
Environment[]
