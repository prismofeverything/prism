pattern Catalysis[enzyme, substrate] (
  Compartment (enzyme: enzyme | substrate: substrate | bystanders: ?rest)
)

pattern CytoOuter[substrate] (
  Compartment (
    kind: Cytoplasm |
    substrate: substrate |
    inner: Compartment (inner_rest: ?inner_rest) |
    outer_rest: ?outer_rest
  )
)

pattern CytoInner[substrate] (
  Compartment (
    kind: Cytoplasm |
    inner: Compartment (substrate: substrate | inner_rest: ?inner_rest) |
    outer_rest: ?outer_rest
  )
)

pattern NucCyto[substrate] (
  Compartment (
    kind: Cytoplasm |
    substrate: substrate |
    inner: Compartment (kind: Nucleus | inner_rest: ?inner_rest) |
    outer_rest: ?outer_rest
  )
)

pattern NucInner[substrate] (
  Compartment (
    kind: Cytoplasm |
    inner: Compartment (kind: Nucleus | substrate: substrate | inner_rest: ?inner_rest) |
    outer_rest: ?outer_rest
  )
)

reaction phosphorylate (
  (compartment: Catalysis[enzyme: MEK ~{out: !}, substrate: ERK[name: ?n] ~{out: !}])
  =>
  (compartment: Catalysis[enzyme: MEK ~{out: ~bond}, substrate: pERK[name: ?n] ~{out: ~bond}])
) rate ( 2.0 )

reaction dissociate (
  (compartment: Catalysis[enzyme: MEK ~{out: ~bond}, substrate: pERK[name: ?n] ~{out: ~bond}])
  =>
  (compartment: Catalysis[enzyme: MEK, substrate: pERK[name: ?n]])
) rate ( 0.5 )

reaction dephosphorylate (
  (outer: NucInner[substrate: pERK[name: ?n] ~{out: !}])
  =>
  (outer: NucInner[substrate: ERK[name: ?n]])
) rate ( 0.4 )

reaction translocate_erk_in (
  (outer: CytoOuter[substrate: ERK[name: ?n]]) => (outer: CytoInner[substrate: ERK[name: ?n]])
) rate ( 1.0 )

reaction translocate_erk_out (
  (outer: CytoInner[substrate: ERK[name: ?n]]) => (outer: CytoOuter[substrate: ERK[name: ?n]])
) rate ( 1.0 )

reaction translocate_perk_in (
  (outer: NucCyto[substrate: pERK[name: ?n] ~{out: !}])
  =>
  (outer: NucInner[substrate: pERK[name: ?n]])
) rate ( 2.0 )

reaction translocate_perk_out (
  (outer: NucInner[substrate: pERK[name: ?n] ~{out: !}])
  =>
  (outer: NucCyto[substrate: pERK[name: ?n]])
) rate ( 0.1 )

composite Mapk[cell: map[any]] ->{cell :: map[any]} (
  cell: cell |

  brs: BRS[
    rules: [
      phosphorylate,
      dissociate,
      dephosphorylate,
      translocate_erk_in,
      translocate_erk_out,
      translocate_perk_in,
      translocate_perk_out,
    ],
    mode: 'gillespie',
    seed: 7,
    max_per_tick: 10000
  ] ~{state: cell} ->{state: cell}
)

Mapk[
  cell: Cell (
    cytoplasm: Compartment (
      kind: Cytoplasm |
      mek: MEK |
      erk0: pERK[name: 'erk0'] |
      erk1: ERK[name: 'erk1'] |
      erk2: ERK[name: 'erk2'] |
      nucleus: Compartment (kind: Nucleus) |
      er_lumen: Compartment (kind: ERLumen | erk3: ERK[name: 'erk3'])
    )
  )
]
