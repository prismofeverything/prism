# Grow / divide, unbounded — chrysalis surface form
# ──────────────────────────────────────────────────────────────────────
# Tier-1 acceptance benchmark #1.
#
# A single cell grows multiplicatively with no resource limit, so the
# population diverges. When a cell's mass crosses `threshold`, it divides:
# it is replaced by two daughters, each carrying half its mass.
#
# This file shows TWO forms of the same phenomenon:
#
#   1. INTERNAL division — the RUNNABLE form (below). Mirrored verbatim by
#      the hand-built AST in crates/chrysalis/src/fixtures/grow_divide.rs
#      and proven end-to-end in crates/chrysalis/tests/grow_divide.rs
#      (one cell → daughters `0_0`, `0_1`). A `Divide` step *inside* each
#      cell reads the cell's own mass and writes daughters UP to the parent
#      `cells` map through the cell's bridge. This is the faithful port of
#      upstream process_bigraph/processes/growth_division.py.
#
#   2. HOMOICONIC division — the TIER-1 STRETCH (at the bottom). Division
#      as a first-class, parent-installed *reaction* that calls the cell's
#      own `.divide()` method. This is the actual research point of the
#      benchmark (reactions AND methods as first-class values), but it needs
#      `type_divide` plus a matchable read-only projection of the cell's
#      mass at the parent surface — not yet runnable. See
#      docs/chrysalis-design.md.
#
# Spec only — the parser is task #12. Units below are the *target* surface;
# the runnable fixture erases them to plain Floats until units land.


# ── Dimensioned scalar types ────────────────────────────────────────
# Units live in the schema; values stay plain Floats. `extensive` opts a
# quantity into splitting on divide (used by form 2's `type_divide`); the
# default is intensive (copy).
unit pg : [mass] = 1e-12 kg

Mass = Quantity[unit: pg, extensive]   # picograms; splits on divide
Rate = Quantity[unit: 1/s]             # intensive; copies on divide
Time = Quantity[unit: s]               # so mass·rate·interval checks to [mass]


process Grow[rate: Rate = 0.02]
  ~{mass: Mass, interval: Time = 1.0}
  ->{mass: Mass}
(
  delta = mass * rate * interval |     # [mass] = [mass]·[1/time]·[time]  ✓
  {mass: delta}
)


# A `Divide` STEP that lives INSIDE each cell. It reads the cell's own mass
# via `trigger`; when that crosses `threshold` it emits a structural update
# on `environment` that removes the cell (`id`) and adds two daughters.
# Because the cell has no inner `environment` slot, that port is a
# PASSTHROUGH: the raw {_remove, _add} crosses the bridge to the parent
# `cells` map intact (true division — original removed, daughters added).
step Divide[id: String, threshold: Mass = 2.0]
  ~{trigger: Mass}
  ->{environment: Map[Cell]}
(
  { environment:
      if trigger > threshold
        then replace id with { '{id}_0': Cell[id: '{id}_0', mass: trigger / 2] ->{environment: @},
                               '{id}_1': Cell[id: '{id}_1', mass: trigger / 2] ->{environment: @} }
        else {} }
)


composite Cell[id: String, mass: Mass = 1.0,
               growth_rate: Rate = 0.02, threshold: Mass = 2.0]
  ~{}
  ->{environment}                      # exposes where daughters are deposited
(
  mass: mass |
  Grow[rate: growth_rate] ~{mass: mass} ->{mass: mass} |
  Divide[id: id, threshold: threshold] ~{trigger: mass} ->{environment: environment}
)


# The environment just holds cells. There is no parent-level BRS in the
# internal-division model — each cell divides itself.
composite Environment[cells: Map[Cell]]
  ~{}
  ->{cells}
(
  cells: cells
)


# `@` is the empty wire `[]`, which the (container-relative) engine resolves
# to the process's own container — here, the `cells` map the cell lives in.
# (`^` → `[".."]` would pop one level too high.)
main = Environment[cells: {'0': Cell[id: '0', mass: 1.2] ->{environment: @}}]
main.run(50.0)


# ── Homoiconic division — NOW RUNS (the research goal) ──────────────────
# Division as a first-class reaction VALUE in a parent BRS, where the matched
# cell divides ITSELF via a type-relative, schema-driven `.divide()` method:
# extensive fields (mass) halve, intensive copy — the rule never hard-codes
# `mass / 2`. Proven by crates/chrysalis/tests/grow_divide_homoiconic.rs.
#
# Notation: `::` is typing, `:` is key:value (disambiguating the colon). A
# nested typed site `?cell::Cell` is an as-pattern: it binds the matched cell
# VALUE to `?cell` (the top-level `?cid : …` binds the key). `divide` takes
# the id, so a cell stores no id (the map key IS the id).
#
#   reaction Divide[threshold :: Mass = 2.0] (
#     ?cid : ?cell::Cell  where ?cell.mass > threshold  =>  ?cell.divide(?cid)
#   )
#
#   composite Environment[cells :: Map[Cell], threshold :: Mass = 2.0]
#     ~{} ->{cells}
#   (
#     cells: cells |
#     BRS[rules: [Divide[threshold: threshold]]] ~{state: cells} ->{state: cells}
#   )
