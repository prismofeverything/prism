# A single cell as a standalone, streamable composite, COMPOSED from imported
# pieces: `Grow` (mass-balanced metabolism, grow.ys) and `Divide` (the propose
# step, divide.ys). Run as `chrysalis run cell.ys --serve-process` it becomes a
# live `Trace[In] -> Trace[Out]` process the parent engine steps over OS pipes,
# exactly as a `stream:cell.ys` node — and identically to a `local:`/`rest:` cell.
# The Rust twin is the cell in crates/prism-bigraph/tests/cells_division.rs.
#
# The cell exposes its `mass` (extensive — halves on divide) and a `divide` flag
# on its OWN node (`%`). It is POSITION-AGNOSTIC: it never names its key in the
# parent map, so the environment (not the cell) owns the structural split. That is
# exactly why the cell is identical across protocols — see environment.ys.

from .grow import Grow       # also brings the `Mass` / `pg` vocabulary
from .divide import Divide


# Its `mass`/`glucose` ports bridge to the inner slots (`@`), so the parent seeds
# them in and reads the exported face out. `acetate`/`divide` are output-only
# faces. Daughters re-realize from this same file at the same address.
composite Cell[k :: Float = 0.35, yield :: Float = 0.6, threshold :: Float = 2.0, mass0 :: Mass = 1.0]
  ~{mass :: Mass @ mass = mass0, glucose :: Float @ glucose = 0.0}
  ->{mass :: Mass @ mass, glucose :: Float @ glucose, acetate :: Float @ acetate, divide :: Bool @ divide}
(
  mass: mass0 |         # `mass` is the cell's OWN state (the %.mass face the env
                        # divides), so it stays internal.
  glucose: glucose |    # `glucose` is a real external input: the env pool drives it
                        # each tick (DRIVEN), and standalone you seed the initial
                        # pool — `chrysalis run cell.ys --glucose 5` (it defaults to
  acetate: 0.0 |        # 0, so a no-flag run is inert but still runs).
  divide: false |
  grow: Grow[k: k, yield: yield]
    ~{mass: mass, glucose: glucose}
    ->{mass: mass, glucose: glucose, acetate: acetate} |
  propose: Divide[threshold: threshold]
    ~{mass: mass}
    ->{divide: divide}
)
# No trailing `Cell[]`: the file's ENTRY is the `Cell` composite itself, so
# `chrysalis run cell.ys --serve-process` invokes it as a streamable subengine
# (a trailing bare term would parse as `main` and run it as a one-shot script).
