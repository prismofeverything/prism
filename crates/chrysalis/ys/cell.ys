# A single cell as a standalone, streamable composite — the `stream:` protocol's
# CHILD. Run as `chrysalis run cell.ys --serve-stream` it becomes a live
# `Trace[In] -> Trace[Out]` process the parent engine steps over OS pipes, exactly
# as a `stream:cell.ys` node. The Rust twin is the cell in
# crates/prism-bigraph/tests/cells_division.rs (addressed local:/rest:); here only
# the address changes — the cell, its bridge, and its conservation are identical.
#
# Mass-balanced metabolism (no mass from nothing): uptake u draws glucose and
# splits it between biomass and excreted acetate, conserving the total —
#   Δmass = u·yield,  Δglucose = −u,  Δacetate = u·(1−yield)  ⇒  Σ Δ = 0.
# The cell exposes its `mass` (extensive — halves on divide) and a `divide` flag
# (the inside half of Form-3 division: it proposes; the environment enacts).

unit pg : [mass] = 1e-12 kg
Mass = Quantity[unit: pg, extensive]    # extensive ⇒ Schema::Delta (splits on divide)


# Mass-balanced uptake: glucose → biomass + acetate. `u` is bounded by the
# available glucose so the shared pool can never go negative.
process Metabolism[k :: Float = 0.35, yield :: Float = 0.6]
  ~{mass :: Float, glucose :: Float, interval :: Float = 1.0}
  ->{mass :: Mass, glucose :: Float, acetate :: Float}
(
  raw = k * glucose * mass * interval |
  u   = if raw > glucose then glucose else raw |
  {mass: u * yield, glucose: -u, acetate: u * (1.0 - yield)}
)


# The inside half of Form-3 division: propose by raising `divide` when biomass
# crosses the threshold. The cell never reaches up to its container — it only
# exposes its readiness on its own face; the environment disposes.
process Trigger[threshold :: Float = 2.0]
  ~{mass :: Float}
  ->{divide :: Bool}
(
  {divide: if mass > threshold then true else false}
)


# The cell. Its `mass`/`glucose` ports bridge to the inner slots (`@`), so the
# parent seeds them in and reads the exported face out. `acetate`/`divide` are
# output-only faces. Daughters re-realize from this same file at the same address.
composite Cell[k :: Float = 0.35, yield :: Float = 0.6, threshold :: Float = 2.0, mass0 :: Mass = 1.0]
  ~{mass :: Mass @ mass, glucose :: Float @ glucose}
  ->{mass :: Mass @ mass, glucose :: Float @ glucose, acetate :: Float @ acetate, divide :: Bool @ divide}
(
  mass: mass0 |
  glucose: 0.0 |
  acetate: 0.0 |
  divide: false |
  metabolism: Metabolism[k: k, yield: yield]
    ~{mass: mass, glucose: glucose}
    ->{mass: mass, glucose: glucose, acetate: acetate} |
  trigger: Trigger[threshold: threshold]
    ~{mass: mass}
    ->{divide: divide}
)
# No trailing `Cell[]`: the file's ENTRY is the `Cell` composite itself, so
# `chrysalis run cell.ys --serve-process` invokes it as a streamable subengine
# (a trailing bare term would parse as `main` and run it as a one-shot script).
