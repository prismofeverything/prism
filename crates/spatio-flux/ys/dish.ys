# A reusable diffusion composite — defined once, importable by other `.ys`
# files. `Diffusion` is a native (extern) spatio-flux process; `Dish` wires it
# over a field map (an additive `array` field).

extern Diffusion
  ~{fields: map[array[[3, 3], float]]}
  ->{fields: map[array[[3, 3], float]]}

composite Dish[fields: map[array[[3, 3], float]]]
  ->{fields: map[array[[3, 3], float]]}
(
  fields: fields |
  diffusion: Diffusion ~{fields: fields} ->{fields: fields}
)
