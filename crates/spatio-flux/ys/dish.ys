# A reusable diffusion composite — defined once, importable by other `.ys`
# files. `DiffusionAdvection` is a native spatio-flux process, imported from
# the `diffusion` module (the `extern` replacement); `Dish` wires it over a
# field map (an additive `array` field).

from diffusion import DiffusionAdvection

composite Dish[fields: map[array[[3, 3], float]]]
  ->{fields: map[array[[3, 3], float]]}
(
  fields: fields |
  diffusion: DiffusionAdvection ~{fields: fields} ->{fields: fields}
)
