# dfba-section.ys — E. coli core dynamic FBA (HiGHS LP), as a report section
# (→ line plot of biomass + substrates). Shared section vocabulary via report.section.
from core import Simulate
from fba import DynamicFBA
from spatio-flux.report.section import Plot, Output

composite DFBASection ->{figure: Figure} (
  state: { substrates: { glucose: 10.0, acetate: 0.0 }, biomass: 0.1 } |
  run: Simulate[
    proc: DynamicFBA[
      model_file: 'textbook',
      bounds: { ATPM: { lower: 1.0, upper: 1.0 }, EX_o2_e: { lower: -2.0 } },
      kinetic_params: { glucose: [0.5, 1.0], acetate: [0.5, 2.0] },
      substrate_update_reactions: { glucose: 'EX_glc__D_e', acetate: 'EX_ac_e' }
    ],
    runtime: 10.0, timestep: 0.5
  ] ~{state: state} ->{trace: traj} |
  plot: Plot[title: 'E. coli core dFBA'] ~{traj: traj} ->{figure: figure} |
  output: Output[path: 'outputs/dfba/ecoli_core'] ~{figure: figure}
)
