# dfba-section.ys — the E. coli core dynamic-FBA sim AS A REPORT SECTION, via the
# codegen path. Runs DynamicFBA (HiGHS LP over the BiGG 'textbook' model) over
# time, captures the {biomass, substrates} trace, and plots it as lines (biomass
# growth + substrate depletion). The FBA family — 8 of the 18 report sims — as a
# .ys section, the SAME Simulate template as kinetics (its ports are kinetics-
# shaped: ~{substrates, biomass}). Config mirrors fixtures/ecoli_core_dfba.json.
from core import Simulate
from io import Path
from fba import DynamicFBA

type Trace = { times: list[float], frames: list[map[float]] }
type Figure = { svg: string }

step Plot[title: string = 'dfba'] ~{traj: Trace} ->{figure: Figure} (
  {figure: traj.plot(title)}
)

step Output[path: Path] ~{figure: Figure} (
  figure.svg(path)
)

composite DFBASection ->{figure: Figure} (
  state: { substrates: { glucose: 10.0, acetate: 0.0 }, biomass: 0.1 } |
  run: Simulate[
    proc: DynamicFBA[
      model_file: 'textbook',
      bounds: { ATPM: { lower: 1.0, upper: 1.0 }, EX_o2_e: { lower: -2.0 } },
      kinetic_params: { glucose: [0.5, 1.0], acetate: [0.5, 2.0] },
      substrate_update_reactions: { glucose: 'EX_glc__D_e', acetate: 'EX_ac_e' }
    ],
    runtime: 10.0, timestep: 0.5
  ] ~{state: state} ->{trace: traj} |
  plot: Plot[title: 'E. coli core dFBA'] ~{traj: traj} ->{figure: figure} |
  output: Output[path: 'outputs/dfba/ecoli_core'] ~{figure: figure}
)
