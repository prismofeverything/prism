# kinetics-section.ys — Monod growth on glucose, as a report section (→ line plot).
# The Plot/Output/Trace/Figure vocabulary is shared via the report.section module.
from core import Simulate
from kinetics import MonodKinetics
from spatio-flux.report.section import Plot, Output

composite KineticsSection ->{figure: Figure} (
  state: { biomass: 0.1, substrates: { glucose: 10.0 } } |
  run: Simulate[
    proc: MonodKinetics[reactions: { growth: { reactant: 'glucose', product: 'biomass', vmax: 1.0 } }],
    runtime: 10.0, timestep: 0.5
  ] ~{state: state} ->{trace: traj} |
  plot: Plot[title: 'Monod growth on glucose'] ~{traj: traj} ->{figure: figure} |
  output: Output[path: 'outputs/kinetics/monod'] ~{figure: figure}
)
