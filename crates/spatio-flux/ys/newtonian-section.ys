# newtonian-section.ys — Newtonian particles (rapier2d, gravity + bounce), as a
# report section (→ animated scatter). Δposition + Δvelocity; shared vocabulary.
from core import Simulate
from particles import NewtonianParticles
from spatio-flux.report.section import Plot, Output

composite NewtonianSection ->{figure: Figure} (
  state: { particles: {
    a: { position: [20.0, 70.0], velocity: [5.0, 0.0], mass: 0.3 },
    b: { position: [40.0, 60.0], velocity: [-3.0, 2.0], mass: 0.5 },
    c: { position: [60.0, 75.0], velocity: [0.0, 0.0], mass: 0.4 }
  } } |
  run: Simulate[
    proc: NewtonianParticles[gravity: [0.0, -9.8], bounds: [80.0, 80.0], elasticity: 0.7],
    runtime: 8.0, timestep: 0.25
  ] ~{state: state} ->{trace: traj} |
  plot: Plot[title: 'Newtonian particles (gravity + bounce)'] ~{traj: traj} ->{figure: figure} |
  output: Output[path: 'outputs/particles/newtonian'] ~{figure: figure}
)
