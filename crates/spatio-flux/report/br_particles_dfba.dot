digraph {
    rankdir=TB;
    size="16,10";
    dpi=70;
    splines=true;

    // State nodes
    state_brownian_movement__interval [shape=circle, style=filled, fillcolor="#C9CED6", color="#9ca0a6", penwidth=1, label="interval", fontsize=12];
    state_fields [shape=circle, style=filled, fillcolor="#F4E6B8", color="#beb38f", penwidth=1, label="fields", fontsize=12];
    state_fields__acetate [shape=circle, style=filled, fillcolor="#F4E6B8", color="#beb38f", penwidth=1, label="acetate", fontsize=12];
    state_fields__glucose [shape=circle, style=filled, fillcolor="#F4E6B8", color="#beb38f", penwidth=1, label="glucose", fontsize=12];
    state_particles [shape=circle, style=filled, fillcolor="#C3E1D6", color="#98afa6", penwidth=1, label="particles", fontsize=12];
    state_particles__YRdKa6aM [shape=circle, style=filled, fillcolor="#C3E1D6", color="#98afa6", penwidth=1, label="YRdKa6aM", fontsize=12];
    state_particles__YRdKa6aM__exchange [shape=circle, style=filled, fillcolor="#EEC06F", color="#b99556", penwidth=1, label="exchange", fontsize=12];
    state_particles__YRdKa6aM__id [shape=circle, style=filled, fillcolor="#C3E1D6", color="#98afa6", penwidth=1, label="id", fontsize=12];
    state_particles__YRdKa6aM__local [shape=circle, style=filled, fillcolor="#F4E6B8", color="#beb38f", penwidth=1, label="local", fontsize=12];
    state_particles__YRdKa6aM__mass [shape=circle, style=filled, fillcolor="#E4CF77", color="#b1a15c", penwidth=1, label="mass", fontsize=12];
    state_particles__YRdKa6aM__position [shape=circle, style=filled, fillcolor="#C3E1D6", color="#98afa6", penwidth=1, label="position", fontsize=12];
    state_particles__YRdKa6aM__sub_masses [shape=circle, style=filled, fillcolor="#C3E1D6", color="#98afa6", penwidth=1, label="sub_masses", fontsize=12];

    // Process nodes
    proc_particles_YRdKa6aM_dFBA [shape=box, style=filled, fillcolor="#A24E56", color="#A24E56", penwidth=0, label="dFBA", fontsize=12];
    proc_brownian_movement [shape=box, style=filled, fillcolor="#C3E1D6", color="#C3E1D6", penwidth=0, label="brownian_movement", fontsize=12];
    proc_enforce_boundaries [shape=box, style=filled, fillcolor="#9FD8DF", color="#9FD8DF", penwidth=0, label="enforce_boundaries", fontsize=12];
    proc_particle_exchange [shape=box, style=filled, fillcolor="#C6D780", color="#C6D780", penwidth=0, label="particle_exchange", fontsize=12];
    proc_particle_division [shape=box, style=filled, fillcolor="#9FD8DF", color="#9FD8DF", penwidth=0, label="particle_division", fontsize=12];

    // Wiring
    state_particles__YRdKa6aM__local -> proc_particles_YRdKa6aM_dFBA [style=dashed, penwidth=1, arrowhead=normal, label="substrates", fontsize=10];
    proc_particles_YRdKa6aM_dFBA -> state_particles__YRdKa6aM__exchange [style=dashed, penwidth=1, arrowhead=normal, label="substrates", fontsize=10];
    state_particles__YRdKa6aM__mass -> proc_particles_YRdKa6aM_dFBA [style=dashed, penwidth=1, dir=both, label="biomass", fontsize=10];
    state_particles -> proc_brownian_movement [style=dashed, penwidth=1, dir=both, label="particles", fontsize=10];
    state_brownian_movement__interval -> proc_enforce_boundaries [style=dashed, penwidth=1, arrowhead=normal, label="process_interval", fontsize=10];
    state_particles -> proc_enforce_boundaries [style=dashed, penwidth=1, dir=both, label="particles", fontsize=10];
    state_particles -> proc_particle_exchange [style=dashed, penwidth=1, dir=both, label="particles", fontsize=10];
    state_fields -> proc_particle_exchange [style=dashed, penwidth=1, dir=both, label="fields", fontsize=10];
    state_particles -> proc_particle_division [style=dashed, penwidth=1, dir=both, label="particles", fontsize=10];

    // Hierarchy
    proc_brownian_movement -> state_brownian_movement__interval [arrowhead=none, penwidth=2];
    state_fields -> state_fields__acetate [arrowhead=none, penwidth=2];
    state_fields -> state_fields__glucose [arrowhead=none, penwidth=2];
    state_particles -> state_particles__YRdKa6aM [arrowhead=none, penwidth=2];
    state_particles__YRdKa6aM -> state_particles__YRdKa6aM__exchange [arrowhead=none, penwidth=2];
    state_particles__YRdKa6aM -> state_particles__YRdKa6aM__id [arrowhead=none, penwidth=2];
    state_particles__YRdKa6aM -> state_particles__YRdKa6aM__local [arrowhead=none, penwidth=2];
    state_particles__YRdKa6aM -> state_particles__YRdKa6aM__mass [arrowhead=none, penwidth=2];
    state_particles__YRdKa6aM -> state_particles__YRdKa6aM__position [arrowhead=none, penwidth=2];
    state_particles__YRdKa6aM -> state_particles__YRdKa6aM__sub_masses [arrowhead=none, penwidth=2];
    // Nested process hierarchy
    state_particles__YRdKa6aM -> proc_particles_YRdKa6aM_dFBA [arrowhead=none, penwidth=2];
}
