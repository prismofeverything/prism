digraph {
    rankdir=TB;
    size="16,10";
    dpi=70;
    splines=true;

    // State nodes
    state_fields [shape=circle, style=filled, fillcolor="#F4E6B8", color="#beb38f", penwidth=1, label="fields", fontsize=12];
    state_fields__acetate [shape=circle, style=filled, fillcolor="#F4E6B8", color="#beb38f", penwidth=1, label="acetate", fontsize=12];
    state_fields__acetate__0 [shape=circle, style=filled, fillcolor="#F4E6B8", color="#beb38f", penwidth=1, label="0", fontsize=12];
    state_fields__acetate__0__0 [shape=circle, style=filled, fillcolor="#F4E6B8", color="#beb38f", penwidth=1, label="0", fontsize=12];
    state_fields__dissolved_biomass [shape=circle, style=filled, fillcolor="#E4CF77", color="#b1a15c", penwidth=1, label="dissolved biomass", fontsize=12];
    state_fields__dissolved_biomass__0 [shape=circle, style=filled, fillcolor="#F4E6B8", color="#beb38f", penwidth=1, label="0", fontsize=12];
    state_fields__dissolved_biomass__0__0 [shape=circle, style=filled, fillcolor="#F4E6B8", color="#beb38f", penwidth=1, label="0", fontsize=12];
    state_fields__glucose [shape=circle, style=filled, fillcolor="#F4E6B8", color="#beb38f", penwidth=1, label="glucose", fontsize=12];
    state_fields__glucose__0 [shape=circle, style=filled, fillcolor="#F4E6B8", color="#beb38f", penwidth=1, label="0", fontsize=12];
    state_fields__glucose__0__0 [shape=circle, style=filled, fillcolor="#F4E6B8", color="#beb38f", penwidth=1, label="0", fontsize=12];

    // Process nodes
    proc_dFBA_0_0_ [shape=box, style=filled, fillcolor="#A24E56", color="#A24E56", penwidth=0, label="dFBA[*] (x100)", fontsize=12];
    proc_diffusion [shape=box, style=filled, fillcolor="#D1BE56", color="#D1BE56", penwidth=0, label="diffusion", fontsize=12];

    // Wiring
    state_fields__acetate__0__0 -> proc_dFBA_0_0_ [style=dashed, penwidth=1, dir=both, label="substrates.acetate", fontsize=10];
    state_fields__dissolved_biomass__0__0 -> proc_dFBA_0_0_ [style=dashed, penwidth=1, dir=both, label="biomass", fontsize=10];
    state_fields__glucose__0__0 -> proc_dFBA_0_0_ [style=dashed, penwidth=1, dir=both, label="substrates.glucose", fontsize=10];
    state_fields -> proc_diffusion [style=dashed, penwidth=1, dir=both, label="fields", fontsize=10];

    // Hierarchy
    state_fields -> state_fields__acetate [arrowhead=none, penwidth=2];
    state_fields__acetate -> state_fields__acetate__0 [arrowhead=none, penwidth=2];
    state_fields__acetate__0 -> state_fields__acetate__0__0 [arrowhead=none, penwidth=2];
    state_fields -> state_fields__dissolved_biomass [arrowhead=none, penwidth=2];
    state_fields__dissolved_biomass -> state_fields__dissolved_biomass__0 [arrowhead=none, penwidth=2];
    state_fields__dissolved_biomass__0 -> state_fields__dissolved_biomass__0__0 [arrowhead=none, penwidth=2];
    state_fields -> state_fields__glucose [arrowhead=none, penwidth=2];
    state_fields__glucose -> state_fields__glucose__0 [arrowhead=none, penwidth=2];
    state_fields__glucose__0 -> state_fields__glucose__0__0 [arrowhead=none, penwidth=2];
    // Nested process hierarchy
}
