    state_particles [shape=circle, style=filled, fillcolor="#C3E1D6", color="#98afa6", penwidth=1, label="particles", fontsize=12];
    state_particles__Gn3AfJxL [shape=circle, style=filled, fillcolor="#C3E1D6", color="#98afa6", penwidth=1, label="Gn3AfJxL", fontsize=12];
    state_particles__Gn3AfJxL__exchange [shape=circle, style=filled, fillcolor="#EEC06F", color="#b99556", penwidth=1, label="exchange", fontsize=12];
