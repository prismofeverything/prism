    state_particles__Gn3AfJxL__local__acetate [shape=circle, style=filled, fillcolor="#C3E1D6", color="#98afa6", penwidth=1, label="acetate", fontsize=12];
    state_particles__Gn3AfJxL__local__dissolved_biomass [shape=circle, style=filled, fillcolor="#E4CF77", color="#b1a15c", penwidth=1, label="dissolved biomass", fontsize=12];
    state_particles__Gn3AfJxL__local__glucose [shape=circle, style=filled, fillcolor="#C3E1D6", color="#98afa6", penwidth=1, label="glucose", fontsize=12];
