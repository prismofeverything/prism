    state_fields__dissolved_biomass__0__0 -> proc_dFBA_0_0_ [style=dashed, penwidth=1, dir=both, label="biomass", fontsize=10];
    state_fields__acetate__0__0 -> proc_dFBA_0_0_ [style=dashed, penwidth=1, dir=both, label="substrates.acetate", fontsize=10];
    state_particles -> proc_particle_division [style=dashed, penwidth=1, dir=both, label="particles", fontsize=10];
    state_fields -> proc_particle_exchange [style=dashed, penwidth=1, dir=both, label="fields", fontsize=10];
    state_particles -> proc_particle_exchange [style=dashed, penwidth=1, dir=both, label="particles", fontsize=10];
    state_brownian_movement__interval -> proc_enforce_boundaries [style=dashed, penwidth=1, arrowhead=normal, label="process_interval", fontsize=10];
    state_particles -> proc_enforce_boundaries [style=dashed, penwidth=1, dir=both, label="particles", fontsize=10];
    state_particles -> proc_brownian_movement [style=dashed, penwidth=1, dir=both, label="particles", fontsize=10];
    state_fields -> proc_diffusion [style=dashed, penwidth=1, dir=both, label="fields", fontsize=10];

    // Hierarchy
    proc_brownian_movement -> state_brownian_movement__interval [arrowhead=none, penwidth=2];
    state_fields -> state_fields__acetate [arrowhead=none, penwidth=2];
    state_fields__acetate -> state_fields__acetate__0 [arrowhead=none, penwidth=2];
    state_fields__acetate__0 -> state_fields__acetate__0__0 [arrowhead=none, penwidth=2];
    state_fields -> state_fields__dissolved_biomass [arrowhead=none, penwidth=2];
    state_fields__dissolved_biomass -> state_fields__dissolved_biomass__0 [arrowhead=none, penwidth=2];
    state_fields__dissolved_biomass__0 -> state_fields__dissolved_biomass__0__0 [arrowhead=none, penwidth=2];
    state_fields -> state_fields__glucose [arrowhead=none, penwidth=2];
    state_fields__glucose -> state_fields__glucose__0 [arrowhead=none, penwidth=2];
    state_fields__glucose__0 -> state_fields__glucose__0__0 [arrowhead=none, penwidth=2];
    state_particles -> state_particles__Gn3AfJxL [arrowhead=none, penwidth=2];
    state_particles__Gn3AfJxL -> state_particles__Gn3AfJxL__exchange [arrowhead=none, penwidth=2];
    state_particles__Gn3AfJxL__exchange -> state_particles__Gn3AfJxL__exchange__acetate [arrowhead=none, penwidth=2];
    state_particles__Gn3AfJxL__exchange -> state_particles__Gn3AfJxL__exchange__dissolved_biomass [arrowhead=none, penwidth=2];
    state_particles__Gn3AfJxL__exchange -> state_particles__Gn3AfJxL__exchange__glucose [arrowhead=none, penwidth=2];
    state_particles__Gn3AfJxL -> state_particles__Gn3AfJxL__local [arrowhead=none, penwidth=2];
    state_particles__Gn3AfJxL__local -> state_particles__Gn3AfJxL__local__acetate [arrowhead=none, penwidth=2];
    state_particles__Gn3AfJxL__local -> state_particles__Gn3AfJxL__local__dissolved_biomass [arrowhead=none, penwidth=2];
    state_particles__Gn3AfJxL__local -> state_particles__Gn3AfJxL__local__glucose [arrowhead=none, penwidth=2];
    state_particles__Gn3AfJxL -> state_particles__Gn3AfJxL__mass [arrowhead=none, penwidth=2];
    state_particles__Gn3AfJxL -> state_particles__Gn3AfJxL__position [arrowhead=none, penwidth=2];
    state_particles__Gn3AfJxL -> state_particles__Gn3AfJxL__sub_masses [arrowhead=none, penwidth=2];
    // Nested process hierarchy
    state_particles__Gn3AfJxL -> proc_particles_Gn3AfJxL_dFBA [arrowhead=none, penwidth=2];
}
