    // Process nodes
    proc_particles_Gn3AfJxL_dFBA [shape=box, style=filled, fillcolor="#A24E56", color="#A24E56", penwidth=0, label="dFBA", fontsize=12];
    proc_dFBA_0_0_ [shape=box, style=filled, fillcolor="#A24E56", color="#A24E56", penwidth=0, label="dFBA[*] (x100)", fontsize=12];
    proc_particle_division [shape=box, style=filled, fillcolor="#9FD8DF", color="#9FD8DF", penwidth=0, label="particle_division", fontsize=12];
