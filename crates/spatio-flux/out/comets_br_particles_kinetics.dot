digraph {
    rankdir=TB;
    size="16,10";
    dpi=70;
    splines=true;

    // State nodes
    state_fields [shape=circle, style=filled, fillcolor="#F4E6B8", color="#beb38f", penwidth=1, label="fields", fontsize=12];
    state_fields__acetate [shape=circle, style=filled, fillcolor="#F4E6B8", color="#beb38f", penwidth=1, label="acetate", fontsize=12];
    state_fields__glucose [shape=circle, style=filled, fillcolor="#F4E6B8", color="#beb38f", penwidth=1, label="glucose", fontsize=12];
    state_particles [shape=circle, style=filled, fillcolor="#C3E1D6", color="#98afa6", penwidth=1, label="particles", fontsize=12];
    state_particles__p0 [shape=circle, style=filled, fillcolor="#C3E1D6", color="#98afa6", penwidth=1, label="p0", fontsize=12];
    state_particles__p0__exchange [shape=circle, style=filled, fillcolor="#EEC06F", color="#b99556", penwidth=1, label="exchange", fontsize=12];
    state_particles__p0__exchange__acetate [shape=circle, style=filled, fillcolor="#C3E1D6", color="#98afa6", penwidth=1, label="acetate", fontsize=12];
    state_particles__p0__exchange__glucose [shape=circle, style=filled, fillcolor="#C3E1D6", color="#98afa6", penwidth=1, label="glucose", fontsize=12];
    state_particles__p0__id [shape=circle, style=filled, fillcolor="#C3E1D6", color="#98afa6", penwidth=1, label="id", fontsize=12];
    state_particles__p0__local [shape=circle, style=filled, fillcolor="#F4E6B8", color="#beb38f", penwidth=1, label="local", fontsize=12];
    state_particles__p0__local__acetate [shape=circle, style=filled, fillcolor="#C3E1D6", color="#98afa6", penwidth=1, label="acetate", fontsize=12];
    state_particles__p0__local__glucose [shape=circle, style=filled, fillcolor="#C3E1D6", color="#98afa6", penwidth=1, label="glucose", fontsize=12];
    state_particles__p0__mass [shape=circle, style=filled, fillcolor="#E4CF77", color="#b1a15c", penwidth=1, label="mass", fontsize=12];
    state_particles__p0__position [shape=circle, style=filled, fillcolor="#C3E1D6", color="#98afa6", penwidth=1, label="position", fontsize=12];
    state_particles__p0__radius [shape=circle, style=filled, fillcolor="#C3E1D6", color="#98afa6", penwidth=1, label="radius", fontsize=12];

    // Process nodes
    proc_diffusion [shape=box, style=filled, fillcolor="#D1BE56", color="#D1BE56", penwidth=0, label="diffusion", fontsize=12];
    proc_movement [shape=box, style=filled, fillcolor="#C3E1D6", color="#C3E1D6", penwidth=0, label="movement", fontsize=12];
    proc_exchange [shape=box, style=filled, fillcolor="#C6D780", color="#C6D780", penwidth=0, label="exchange", fontsize=12];

    // Wiring
    state_fields -> proc_diffusion [style=dashed, penwidth=1, dir=both, label="fields", fontsize=10];
    state_particles -> proc_movement [style=dashed, penwidth=1, dir=both, label="particles", fontsize=10];
    state_fields -> proc_exchange [style=dashed, penwidth=1, dir=both, label="fields", fontsize=10];
    state_particles -> proc_exchange [style=dashed, penwidth=1, dir=both, label="particles", fontsize=10];

    // Hierarchy
    state_fields -> state_fields__acetate [arrowhead=none, penwidth=2];
    state_fields -> state_fields__glucose [arrowhead=none, penwidth=2];
    state_particles -> state_particles__p0 [arrowhead=none, penwidth=2];
    state_particles__p0 -> state_particles__p0__exchange [arrowhead=none, penwidth=2];
    state_particles__p0__exchange -> state_particles__p0__exchange__acetate [arrowhead=none, penwidth=2];
    state_particles__p0__exchange -> state_particles__p0__exchange__glucose [arrowhead=none, penwidth=2];
    state_particles__p0 -> state_particles__p0__id [arrowhead=none, penwidth=2];
    state_particles__p0 -> state_particles__p0__local [arrowhead=none, penwidth=2];
    state_particles__p0__local -> state_particles__p0__local__acetate [arrowhead=none, penwidth=2];
    state_particles__p0__local -> state_particles__p0__local__glucose [arrowhead=none, penwidth=2];
    state_particles__p0 -> state_particles__p0__mass [arrowhead=none, penwidth=2];
    state_particles__p0 -> state_particles__p0__position [arrowhead=none, penwidth=2];
    state_particles__p0 -> state_particles__p0__radius [arrowhead=none, penwidth=2];
    // Nested process hierarchy
}
