digraph {
    rankdir=TB;
    size="16,10";
    dpi=70;
    splines=true;

    // State nodes
    state_fields [shape=circle, style=filled, fillcolor="#F4E6B8", color="#beb38f", penwidth=1, label="fields", fontsize=12];
    state_particles [shape=circle, style=filled, fillcolor="#C3E1D6", color="#98afa6", penwidth=1, label="particles", fontsize=12];

    // Process nodes
    proc_movement [shape=box, style=filled, fillcolor="#C3E1D6", color="#C3E1D6", penwidth=0, label="movement", fontsize=12];
    proc_exchange [shape=box, style=filled, fillcolor="#C6D780", color="#C6D780", penwidth=0, label="exchange", fontsize=12];

    // Wiring
    state_particles -> proc_movement [style=dashed, penwidth=1, dir=both, label="particles", fontsize=10];
    state_fields -> proc_exchange [style=dashed, penwidth=1, dir=both, label="fields", fontsize=10];
    state_particles -> proc_exchange [style=dashed, penwidth=1, dir=both, label="particles", fontsize=10];

    // Hierarchy
}
