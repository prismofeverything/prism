# Q2 of #36 — Classical wire (LOCC: Local Ops + Classical Communication).
# ──────────────────────────────────────────────────────────────────────────
#
# Alice prepares |+>, MEASURES it (collapsing to a classical bit), and sends that
# bit — and ONLY that bit — to Bob over a classical channel. Bob applies a
# conditional gate (here: prepares his qubit to MATCH the bit). Afterwards Alice's
# and Bob's qubits are CLASSICALLY CORRELATED (both |0> or both |1>, 50/50) but
# NOT entangled — a local measurement on either tells you everything; no Bell
# inequality is violated.
#
# This is the LOCC primitive (shared randomness + local quantum ops). Only a
# classical String crosses, never amplitudes — that is what distinguishes it from
# a quantum (entangling) link. Teleportation (Q6) layers a pre-shared Bell pair on
# top of this same classical scaffolding to send actual quantum state.
#
# Run: `chrysalis run packages/quantum/ys/quantum-locc.ys --time 0`
from .circuit import h, x

# Alice: |0> -> H -> |+> -> measure -> a classical bit ('0' or '1').
def alice_init :: Qubits = {'0': 1.0}
def alice_bit  = alice_init.h(0).measure(42)

# The classical wire carries `alice_bit`. Bob conditionally prepares |alice_bit>.
def bob_init  :: Qubits = {'0': 1.0}
def bob_state = if alice_bit == '1' then bob_init.x(0) else bob_init

# Bob's own readout matches Alice's bit — classical correlation, no entanglement.
def bob_bit = bob_state.measure(99)

composite LOCC ~{} ->{
  alice_bit :: String,
  bob_bit   :: String,
  bob_state :: Qubits
} (
  alice_bit: alice_bit |
  bob_bit:   bob_bit |
  bob_state: bob_state
)
