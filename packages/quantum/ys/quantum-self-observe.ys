# Q5 of #36 — self-observation: a composite checking its own
# factorizability at runtime, via the `Qubits` type's `factorize` method.
# ────────────────────────────────────────────────────────────────────
#
# A two-qubit composite holds a JOINT `Qubits` register. A `FactorizeCheck`
# process runs each tick: reads the state, calls `state.factorize(1)`, and
# writes the result to an `observation` slot. The composite EFFECTIVELY
# KNOWS whether its qubits are entangled — the substrate for auto-divide
# (see quantum-auto-split.ys, which turns the verdict into a structural
# split).
#
#   1. EntangledSystem — Bell state (|00⟩+|11⟩)/√2 → observation.separable false.
#   2. SeparableSystem — |+⟩⊗|+⟩ → observation.separable true, with the factors.
#
# Run: `chrysalis run quantum-self-observe.ys --time 1`

from .quantum-system import QuantumSystem

# Reads its `Qubits` input and writes the factorization record — a real
# `{separable, a, b}`, NOT `any`.
process FactorizeCheck
  ~{state :: Qubits}
  ->{observation :: overwrite[Factorization]}
(
  {observation: state.factorize(1.0)}
)

composite EntangledSystem[state0 :: Qubits = {'00': 0.7071, '01': 0.0, '10': 0.0, '11': 0.7071}]
  ->{
  state       :: Qubits,
  observation :: Factorization
} (
  state: state0 |
  observation: {separable: false} |
  check: FactorizeCheck ~{state: state} ->{observation: observation}
)

composite SeparableSystem[state0 :: Qubits = {'00': 0.5, '01': 0.5, '10': 0.5, '11': 0.5}]
  ->{
  state       :: Qubits,
  observation :: Factorization
} (
  state: state0 |
  observation: {separable: false} |
  check: FactorizeCheck ~{state: state} ->{observation: observation}
)

composite SelfObserveDemo ~{} ->{
  entangled_state       :: Qubits,
  entangled_observation :: Factorization,
  separable_state       :: Qubits,
  separable_observation :: Factorization
} (
  entangled: EntangledSystem ~{} ->{state: entangled_state, observation: entangled_observation} |
  separable: SeparableSystem ~{} ->{state: separable_state, observation: separable_observation}
)
