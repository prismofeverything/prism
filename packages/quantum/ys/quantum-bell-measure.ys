# Quantum Bell-state measurement — observed outcomes from real entanglement.
# ──────────────────────────────────────────────────────────────────────────
#
# Builds the Bell state `(|00⟩ + |11⟩)/√2` from canonical gates, then MEASURES
# four times with deterministic seeds. Every outcome is either `00` or `11` —
# never `01` or `10`. The two qubits are perfectly correlated: measure 0 on q0
# and you measure 0 on q1; measure 1 and you measure 1.
#
# This is REAL ENTANGLEMENT, observed: the joint distribution can't be factored
# as `(p0|0⟩ + p1|1⟩) ⊗ (q0|0⟩ + q1|1⟩)`. `state.measure(seed)` does the Born
# rule (`|amp|²`) + the deterministic sample internally — the same `Qubits`
# method the rest of the tool uses (no hand-rolled probabilities).
#
# Run: `chrysalis run quantum-bell-measure.ys --time 0`
# Expected: four outcomes, all `00` or `11`, NEVER `01` or `10`.

def bell :: Qubits = {'00': 1.0}
def bell_state = bell.hadamard(0).cnot(0, 1)    # (|00⟩ + |11⟩)/√2

# Four measurements with different seeds. `measure(seed)` returns the observed
# basis bitstring; for the Bell state it is always `00` or `11`.
composite QuantumBellMeasure ~{} ->{
  bell_state  :: Qubits,
  obs_seed_1  :: String,
  obs_seed_2  :: String,
  obs_seed_42 :: String,
  obs_seed_99 :: String
} (
  bell_state:  bell_state |
  obs_seed_1:  bell_state.measure(1) |
  obs_seed_2:  bell_state.measure(2) |
  obs_seed_42: bell_state.measure(42) |
  obs_seed_99: bell_state.measure(99)
)
