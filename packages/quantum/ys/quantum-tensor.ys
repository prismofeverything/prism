# Q3 of #36 — `tensor`: the inverse of `divide`, now a METHOD on `Qubits`.
# ────────────────────────────────────────────────────────────────────
#
# Two SEPARABLE single-qubit registers combine into one 2-qubit joint
# register via `a.tensor(b)`. The result is still separable — equivalent
# to keeping the qubits apart. To create real entanglement, apply a
# coupling gate (`.cnot(c, t)`) AFTER tensoring.
#
# `docs/quantum-bigraphs.md` §III: tensor is the structural-composition
# inverse of `divide`. `tensor`/`factorize`/`cnot`/… are the `Qubits`
# type's algebra (methods), not free `meta` functions — see
# `crates/chrysalis/src/quantum.rs`.
#
# Run: `chrysalis run quantum-tensor.ys --time 0`

# ── Two separable single-qubit registers. `Qubits` values carry `_type`.
def plus_state :: Qubits = {'0': 0.7071, '1': 0.7071}   # |+⟩ = (|0⟩+|1⟩)/√2
def zero_state :: Qubits = {'0': 1.0,    '1': 0.0}       # |0⟩

# ── Tensor product (a METHOD): combine two separable systems into one.
def two_plus  = plus_state.tensor(plus_state)
# → { '00': 0.5, '01': 0.5, '10': 0.5, '11': 0.5 } — separable
def plus_zero = plus_state.tensor(zero_state)
# → { '00': 0.707, '01': 0, '10': 0.707, '11': 0 } — also separable

composite TensorDemo ~{} ->{
  plus_state :: Qubits,
  two_plus   :: Qubits,
  plus_zero  :: Qubits
} (
  plus_state: plus_state |
  two_plus:   two_plus |
  plus_zero:  plus_zero
)
