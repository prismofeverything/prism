# Quantum gates as engine PROCESSES — with MEASUREMENT.
# ─────────────────────────────────────────────────────────
#
# Extends `quantum-engine.ys` with a `Measure` process that collapses the final
# state to an observed basis outcome. Three stages fire across three BSP ticks;
# the fourth slot (`observed`) carries the result.
#
# A COMPLETE quantum experiment through the prism engine: state prep, gate
# application, AND measurement — every step a `process`, every wire a place-graph
# edge. Each gate calls the canonical `Qubits` method; `Measure` calls
# `state.measure(seed)` (Born `|amp|²` + deterministic sample, internal).
#
# Run: `chrysalis run quantum-engine-measure.ys --time 3`
# Expected after 3 ticks: s_after_cnot = { '00': 0.707, '11': 0.707 };
#   observed = "11" (or "00", never "01"/"10").

def init_00 :: Qubits = {'00': 1.0}
# A tagged-Qubits placeholder for the intermediate slots: gate methods dispatch on
# the `_type` tag, so a slot a gate READS must start as a `Qubits`, not a bare map.
def empty :: Qubits = {'00': 0.0}

process Hadamard ~{state :: Qubits} ->{state :: Qubits}
(
  {state: state.hadamard(0)}
)

process CNOT ~{state :: Qubits} ->{state :: Qubits}
(
  {state: state.cnot(0, 1)}
)

# Measure: Born-rule sample of the live state. `state.measure(seed)` returns the
# observed basis bitstring (the `Qubits` method does |amp|² + the sample).
process Measure[seed :: Float = 42.0]
  ~{state :: Qubits}
  ->{outcome :: overwrite[any]}
(
  {outcome: state.measure(seed)}
)

composite BellMeasure ~{} ->{
  s_init       :: Qubits,
  s_after_h    :: Qubits,
  s_after_cnot :: Qubits,
  observed     :: any
} (
  s_init:       init_00 |
  s_after_h:    empty |
  s_after_cnot: empty |
  observed:     'unmeasured' |
  h:  Hadamard ~{state: s_init}                  ->{state: s_after_h} |
  cn: CNOT     ~{state: s_after_h}               ->{state: s_after_cnot} |
  m:  Measure[seed: 42.0] ~{state: s_after_cnot} ->{outcome: observed}
)
