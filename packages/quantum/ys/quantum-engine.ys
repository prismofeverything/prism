# Quantum gates as real prism PROCESSES, wired into a place-graph pipeline and
# ticked by the engine — the engine-process form of a circuit (vs the one-tick
# `state.run([…])` of `quantum-circuit.ys`).
#
# Each gate is a `process` with `~{state}` input + `->{state}` output ports; the
# composite chains them across state slots, so a WIRE between slots IS a
# correlation. The engine schedules the gates; the algebra applies the overwrites;
# the BSP tick steps the circuit one gate at a time (`s_init → s_after_h →
# s_after_cnot`).
#
# Each gate now calls the canonical `Qubits` METHOD (`state.hadamard(0)` /
# `state.cnot(0,1)`) — no hand-rolled amplitude bodies. `:: Qubits` carries its own
# overwrite-apply, so no `overwrite[…]` wrapper is needed: the type knows its law.
#
# Run: `chrysalis run quantum-engine.ys --time 2`
# Expected after 2 ticks: s_after_cnot = { '00': 0.707, '11': 0.707 } — the Bell
# state, computed by the engine tick-by-tick.

def init_00 :: Qubits = {'00': 1.0}
# A tagged-Qubits placeholder for the intermediate slots: gate methods dispatch on
# the `_type` tag, so a slot a gate READS must start as a `Qubits`, not a bare map.
def empty :: Qubits = {'00': 0.0}

process Hadamard ~{state :: Qubits} ->{state :: Qubits}
(
  {state: state.hadamard(0)}
)

process CNOT ~{state :: Qubits} ->{state :: Qubits}
(
  {state: state.cnot(0, 1)}
)

composite BellCircuit ~{} ->{
  s_init       :: Qubits,
  s_after_h    :: Qubits,
  s_after_cnot :: Qubits
} (
  s_init:       init_00 |
  s_after_h:    empty |
  s_after_cnot: empty |
  h:  Hadamard ~{state: s_init}    ->{state: s_after_h} |
  cn: CNOT     ~{state: s_after_h} ->{state: s_after_cnot}
)
