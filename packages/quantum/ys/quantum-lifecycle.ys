# Q4-spirit demo of #36 — quantum entanglement LIFECYCLE through the
# place graph (the structural reflection of "one program vs many").
# ────────────────────────────────────────────────────────────────────
#
# Three phases, visible at three `--time` snapshots:
#       initial             →   split                →   merged
#   { ab: <|++⟩> }    →    { a: <|+⟩>, b: <|+⟩> } →   { ab2: <|++⟩> }
#   --time 0          →    --time 1               →   --time 2+
#
# `systems :: map[QuantumSystem]` — each entry a REAL sub-composite with
# its own Publish + bridge. The `Lifecycle` process reads each sibling's
# `Qubits` state and uses the type's METHODS — `state.factorize(1)` to
# split, `a.tensor(b)` to merge — emitting `_remove`/`_add` structural
# intents. See docs/merge-protocol.md + docs/quantum-bigraphs.md.

from .quantum-system import QuantumSystem

process Lifecycle ~{systems :: map[QuantumSystem]} ->{systems :: map[QuantumSystem]}
(
  if 'ab' in systems then
    {systems: {
      _remove: ['ab'],
      _add: {
        a: QuantumSystem[state0: systems.ab.state.factorize(1.0).a]
            ~{state: %.state} ->{state: %.state},
        b: QuantumSystem[state0: systems.ab.state.factorize(1.0).b]
            ~{state: %.state} ->{state: %.state}
      }
    }}
  else
    if 'a' in systems then
      if 'b' in systems then
        {systems: {
          _remove: ['a', 'b'],
          _add: {
            ab2: QuantumSystem[state0: systems.a.state.tensor(systems.b.state)]
                  ~{state: %.state} ->{state: %.state}
          }
        }}
      else
        {systems: {}}
    else
      {systems: {}}
)

composite Lab ~{} ->{
  systems :: map[QuantumSystem] @ systems
} (
  systems: {
    ab: QuantumSystem[state0: {'00': 0.5, '01': 0.5, '10': 0.5, '11': 0.5}]
      ~{state: %.state} ->{state: %.state}
  } |
  cycle: Lifecycle ~{systems: systems} ->{systems: systems}
)
