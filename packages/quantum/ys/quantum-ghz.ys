# 3-qubit GHZ state through the prism engine.
# ────────────────────────────────────────────
#
# The Greenberger-Horne-Zeilinger state: (|000⟩ + |111⟩) / √2 — a
# 3-qubit generalization of the Bell state. All three qubits perfectly
# correlated; measure any one and you've fixed the other two.
#
# Construction: H on q0, then CNOT(q0,q1), then CNOT(q0,q2). Each gate
# is a `process`; the BSP tick propagates the state through 4 slots
# across 4 ticks; the GHZ state emerges at the final slot.
#
# Convention: bit-string bXYZ means q0=X, q1=Y, q2=Z (big-endian).
#
# Run: `chrysalis run quantum-ghz.ys --time 4`
# Expected after 4 ticks (ε ≈ 1e-4):
#   s_final: { amp_000: 0.707, amp_111: 0.707, all others: 0 }
#   observed: "b000" or "b111" (never anything else — perfect 3-way correlation)

from meta import sample

def zero8 = {
  amp_000: 0.0, amp_001: 0.0, amp_010: 0.0, amp_011: 0.0,
  amp_100: 0.0, amp_101: 0.0, amp_110: 0.0, amp_111: 0.0
}

def init_000 = {
  amp_000: 1.0, amp_001: 0.0, amp_010: 0.0, amp_011: 0.0,
  amp_100: 0.0, amp_101: 0.0, amp_110: 0.0, amp_111: 0.0
}

# Hadamard on q0 (the leftmost bit). Pairs (b0YZ, b1YZ) recombine:
#   new(b0YZ) = (old(b0YZ) + old(b1YZ)) / √2
#   new(b1YZ) = (old(b0YZ) - old(b1YZ)) / √2
process HadamardQ0 ~{state :: overwrite[any]} ->{state :: overwrite[any]}
(
  {state: {
    amp_000: ((state.amp_000 + state.amp_100) / 1.41421356),
    amp_001: ((state.amp_001 + state.amp_101) / 1.41421356),
    amp_010: ((state.amp_010 + state.amp_110) / 1.41421356),
    amp_011: ((state.amp_011 + state.amp_111) / 1.41421356),
    amp_100: ((state.amp_000 - state.amp_100) / 1.41421356),
    amp_101: ((state.amp_001 - state.amp_101) / 1.41421356),
    amp_110: ((state.amp_010 - state.amp_110) / 1.41421356),
    amp_111: ((state.amp_011 - state.amp_111) / 1.41421356)
  }}
)

# CNOT(q0 control, q1 target): if q0=1, flip q1.
# Affects b1YZ pairs (b10Z ↔ b11Z); leaves b0YZ alone.
process CNOTq0q1 ~{state :: overwrite[any]} ->{state :: overwrite[any]}
(
  {state: {
    amp_000: state.amp_000,
    amp_001: state.amp_001,
    amp_010: state.amp_010,
    amp_011: state.amp_011,
    amp_100: state.amp_110,   # was |110⟩ — q0=1, q1 flipped 0→1 gives |100⟩
    amp_101: state.amp_111,   # was |111⟩
    amp_110: state.amp_100,
    amp_111: state.amp_101
  }}
)

# CNOT(q0 control, q2 target): if q0=1, flip q2.
process CNOTq0q2 ~{state :: overwrite[any]} ->{state :: overwrite[any]}
(
  {state: {
    amp_000: state.amp_000,
    amp_001: state.amp_001,
    amp_010: state.amp_010,
    amp_011: state.amp_011,
    amp_100: state.amp_101,   # q0=1, q2 flipped 1→0 gives |100⟩
    amp_101: state.amp_100,
    amp_110: state.amp_111,
    amp_111: state.amp_110
  }}
)

# Measure: Born probabilities over all 8 basis states.
process Measure[seed :: Float = 42.0]
  ~{state :: any}
  ->{outcome :: overwrite[any]}
(
  {outcome: sample({
    b000: (state.amp_000 * state.amp_000),
    b001: (state.amp_001 * state.amp_001),
    b010: (state.amp_010 * state.amp_010),
    b011: (state.amp_011 * state.amp_011),
    b100: (state.amp_100 * state.amp_100),
    b101: (state.amp_101 * state.amp_101),
    b110: (state.amp_110 * state.amp_110),
    b111: (state.amp_111 * state.amp_111)
  }, seed)}
)

# GHZ circuit: 5 state slots, 4 gates wired sequentially. Run for
# 4 BSP ticks to fully propagate.
composite GhzCircuit ~{} ->{
  s_init   :: any,
  s_h      :: any,
  s_cnot1  :: any,
  s_cnot2  :: any,   # ← the GHZ state
  observed :: any
} (
  s_init:   init_000 |
  s_h:      zero8 |
  s_cnot1:  zero8 |
  s_cnot2:  zero8 |
  observed: 'unmeasured' |
  h:  HadamardQ0 ~{state: s_init}  ->{state: s_h}     |
  c1: CNOTq0q1   ~{state: s_h}     ->{state: s_cnot1} |
  c2: CNOTq0q2   ~{state: s_cnot1} ->{state: s_cnot2} |
  m:  Measure[seed: 7.0] ~{state: s_cnot2} ->{outcome: observed}
)
