# Q1 of #36 — two independent quantum systems, side by side.
# ──────────────────────────────────────────────────────────
#
# Two SEPARATE `Qubits` registers, `alice` and `bob`, each prepared as a Bell
# pair and measured with its own seed. They share nothing — no link, no joint
# state: genuinely independent systems (the simplest separable case). Each is
# internally Bell-correlated (`00`/`11`), but alice's outcome does NOT constrain
# bob's.
#
# `docs/quantum-bigraphs.md` §V: "Separable qubits can live in different
# processes / composites." The total state factors as `alice ⊗ bob`; there is no
# entanglement across the two registers. Each Bell pair is composed from the
# canonical `Qubits` gate methods.
#
# Run: `chrysalis run quantum-two-bells.ys --time 0`

def alice :: Qubits = {'00': 1.0}
def bob   :: Qubits = {'00': 1.0}

def alice_bell = alice.hadamard(0).cnot(0, 1)   # (|00⟩ + |11⟩)/√2
def bob_bell   = bob.hadamard(0).cnot(0, 1)     # an independent Bell pair

composite TwoBellPairs ~{} ->{
  alice_state :: Qubits,
  bob_state   :: Qubits,
  alice_obs   :: String,
  bob_obs     :: String
} (
  alice_state: alice_bell |
  bob_state:   bob_bell |
  alice_obs:   alice_bell.measure(42) |
  bob_obs:     bob_bell.measure(7)
)
