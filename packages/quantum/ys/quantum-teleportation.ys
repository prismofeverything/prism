# Q6 of #36 — Quantum teleportation. The canonical protocol. ⚡
# ──────────────────────────────────────────────────────────────────────────
#
# Alice has an unknown state |ψ> = 0.6|0> + 0.8|1> on qubit A1; Alice & Bob share
# a Bell pair on (A2, B). The protocol (Bennett et al. 1993):
#   1. Alice: CNOT(A1, A2) then H(A1).
#   2. Alice MEASURES A1 and A2 (collapse!) → two classical bits (a1, a2).
#   3. Alice sends the two bits to Bob over a classical channel.
#   4. Bob applies Z^a1 · X^a2 to his qubit B.
#   5. Bob's qubit B is now |ψ> — teleported, though no quantum info crossed the
#      wire and no-cloning is preserved (Alice's measurement destroyed her copy).
#
# This re-expression uses the canonical gates + `observe` (measurement WITH
# collapse): Alice's measurement genuinely collapses the joint 3-qubit state, so
# Bob's qubit is left in the correct post-measurement state for his correction.
# Qubits: 0 = A1, 1 = A2, 2 = B.
#
# Run: `chrysalis run packages/quantum/ys/quantum-teleportation.ys --time 0`
from .circuit import ry, h, cnot, x, z

# |ψ> = 0.6|0> + 0.8|1> = ry(angle)|0>, angle = 2·atan2(0.8, 0.6).
def psi_angle = 1.8545904

# Prepare |ψ>_A1 ⊗ |Φ+>_A2B, then Alice's CNOT(A1,A2) and H(A1).
def init :: Qubits = {'000': 1.0}
def prepared = init.run([ry(0, psi_angle), h(1), cnot(1, 2), cnot(0, 1), h(0)])

# Alice measures A1 (q0) and A2 (q1) WITH collapse → two classical bits.
def m1 = prepared.observe(0, 42)
def a1 = m1.outcome
def m2 = m1.state.observe(1, 7)
def a2 = m2.outcome

# Bob's correction on qubit B (q2): X if a2 = 1, then Z if a1 = 1.
def corrected = if a2 == '1' then m2.state.x(2) else m2.state
def bob_final = if a1 == '1' then corrected.z(2) else corrected

# Fidelity: if Bob's qubit B is exactly |ψ>, then un-preparing it (ry(-angle) on
# q2) returns it to |0>, so P(q2 = 0) = 1 — exact teleportation, for ANY (a1, a2).
def fidelity = bob_final.ry(2, -1.8545904).prob('**0')

composite Teleport ~{} ->{
  a1        :: String,
  a2        :: String,
  fidelity  :: float,
  bob_final :: Qubits
} (
  a1:        a1 |
  a2:        a2 |
  fidelity:  fidelity |
  bob_final: bob_final
)
