# arguments are config
process Grow(
  rate: Float = 0.2
) {
  # arguments to update are inputs schema
  # for processes interval is always present and last
  update(mass: Float, interval: Float = 0.1) {
    delta = mass * rate * interval

    # elements of result are outputs schema
    result {
      mass: delta
    }
  }
}

step Divide(
  id: String
  threshold: Float = 2.0
) {
  update(trigger: Float, self: Cell) {
    if trigger > threshold {
      left = '{id}_0'
      right = '{id}_1'

      result {
        division: replace id with {
          '{left}': Cell(mass: self.mass / 2),
          '{right}': Cell(mass: self.mass / 2),
        }
      }
    }
  }
}

# if defaults are provided they are optional, otherwise required
composite Cell(id: String, mass: Float = 1.0, growth_rate: Float = 0.02) {
  # the "mass" key lives here but it will get generated by realize()
  # but we should be able to provide overrides from the composite call?
  mass: mass
  grow: Grow(rate: growth_rate)
    {mass: mass} --> {mass: mass}

  divide: Divide(id: id, threshold: 2.0)
    {trigger: mass, self: @} --> {division: ^}

}

composite Environment(cells: Map[Cell]) {
  cells: cells
}

initial_cells = {
  0: Cell(id: '0', mass: 1.2)
}

# we have composites inside another composite
environment = Environment(cells: initial_cells)
environment.run(10.0)

# lots of different plotting methods?
plot('traces', environment.history)